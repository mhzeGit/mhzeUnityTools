+    /// <summary>Bake the mesh ambient-occlusion map with the same CPU baker the Bake Map node uses and store it as the
+    /// project's "ao" baked map (UV space, project resolution). Nothing is applied to a layer until <see cref="ApplyRegionAo"/>.</summary>
+    public async Task BakeAoMapAsync(int rays = 64, float radius = 1f, float bias = 0.05f, float strength = 1f,
+        bool denoise = true, int denoiseIterations = 2, CancellationToken cancellationToken = default)
+    {
+        EnsureUsableUvs();
+        if (rays < 4 || rays > 1024) throw new ArgumentException("AO rays must be between 4 and 1024.");
+        if (!float.IsFinite(radius) || radius <= 0) throw new ArgumentException("AO radius must be positive (world units).");
+        if (!float.IsFinite(bias) || bias < 0) throw new ArgumentException("AO bias must be zero or positive.");
+        if (!float.IsFinite(strength) || strength < 0 || strength > 2) throw new ArgumentException("AO strength must be between 0 and 2.");
+        int size = _textureResolution;
+        var mesh = ImportedModel;
+        var ao = await Task.Run(() => BakeAoCore.BakeAoCpu(mesh.Positions, mesh.Uvs, mesh.Indices, size,
+            mesh.Normals.Length > 0 ? mesh.Normals : null, rays, radius, bias, strength,
+            partIds: null, localOnly: false, denoise: denoise, denoiseIterations: Math.Max(1, denoiseIterations),
+            shouldCancel: () => cancellationToken.IsCancellationRequested), cancellationToken);
+        cancellationToken.ThrowIfCancellationRequested();
+        _bakedMaps.Maps["ao"] = BakeAoCore.EncodeAoToRgba8(ao.Ao, ao.Covered, size);
+        _bakedMaps.Artifacts["ao"] = new BakedMapArtifact(size, null, null, null, 0, MeshFingerprint.Of(mesh));
+        _bakeSettings ??= new BakeSettings { Size = size, Padding = 0, Enabled = new MapEnableSettings
+            { Ao = false, Position = false, LocalPosition = false, Thickness = false, Curvature = false, HighPoly = false, WorldNormal = false, Tangent = false, Seam = false } };
+        _bakeSettings.Enabled ??= new MapEnableSettings();
+        _bakeSettings.Enabled.Ao = true;
+        _bakeSettings.Ao = new AoBakeSettingsData { Samples = rays, Radius = radius, Strength = strength, Denoise = denoise, DenoiseIters = Math.Max(1, denoiseIterations) };
+        IsDirty = true;
+    }
+
+    /// <summary>Multiply the baked ambient occlusion over a region's base colour: Bake Map (Ambient Occlusion) is Color A of a
+    /// Multiply Blend node whose Color B is the region's texture colour; the Blend result drives the Surface layer's Base Color.
+    /// Run after <see cref="AssignRegionTexture"/> and <see cref="BakeAoMapAsync"/>; calling it again only updates the strength.</summary>
+    public void ApplyRegionAo(string folder, float strength = 1f, string? material = null)
+    {
+        if (!_bakedMaps.Maps.ContainsKey("ao")) throw new InvalidOperationException("Bake the ambient-occlusion map first (bakeAo).");
+        if (!float.IsFinite(strength) || strength < 0 || strength > 1) throw new ArgumentException("AO strength must be between 0 and 1.");
+        var parent = FindAuthorFolder(folder, material);
+        var layer = parent.Children.SingleOrDefault(l => l.Name == "Surface" && !l.IsFolder)
+            ?? throw new ArgumentException("Folder must have one Surface child layer.");
+        var graph = layer.Graph;
+        var output = graph.Nodes.OfType<OutputNode>().Single();
+        var blend = graph.Nodes.OfType<BlendNode>().SingleOrDefault();
+        if (blend == null)
+        {
+            var wire = graph.Connections.SingleOrDefault(c => c.To.Node == output && c.To.Port == output.Inputs[0])
+                ?? throw new ArgumentException("Assign a texture to the folder before applying AO.");
+            var sourceNode = wire.From.Node;
+            var sourcePort = wire.From.Port;
+            graph.Disconnect(wire);
+            blend = new BlendNode(260, 0);
+            graph.AddNode(blend);
+            var bake = new BakeMapNode(100, 140);
+            graph.AddNode(bake);
+            bake.SetInputValue(bake.MapPort, "Ambient Occlusion");
+            blend.SetInputValue(blend.Inputs[0], "Multiply");
+            if (!graph.Connect(sourceNode, sourcePort, blend, blend.Inputs[3])) throw new InvalidOperationException("Cannot connect the texture to the AO blend (Color B).");
+            if (!graph.Connect(bake, bake.ResultPort, blend, blend.Inputs[2])) throw new InvalidOperationException("Cannot connect Bake Map to the AO blend (Color A).");
+            if (!graph.Connect(blend, blend.Outputs[0], output, output.Inputs[0])) throw new InvalidOperationException("Cannot connect the AO blend to Surface Base Color.");
+        }
+        blend.SetInputValue(blend.Inputs[1], strength);
+        graph.InvalidateAllCaches();
+        IsDirty = true;
+    }
